+namespace
+{
+std::string task_id_path(std::string_view torrent_dir, std::string_view info_hash)
+{
+    auto path = std::string{ torrent_dir };
+    path += '/';
+    path += info_hash;
+    path += ".taskid";
+    return path;
+}
+} // namespace
+
+void tr_torrents_write_task_id(std::string_view torrent_dir, std::string_view info_hash, tr_torrent_id_t id)
+{
+    if (std::empty(torrent_dir) || std::empty(info_hash) || id <= tr_torrent_id_t{})
+    {
+        return;
+    }
+
+    auto const path = task_id_path(torrent_dir, info_hash);
+    if (auto* const fp = std::fopen(path.c_str(), "we"); fp != nullptr)
+    {
+        std::fprintf(fp, "%d\n", static_cast<int>(id));
+        std::fclose(fp);
+    }
+}
+
+tr_torrent_id_t tr_torrents_read_task_id(std::string_view torrent_dir, std::string_view info_hash)
+{
+    if (std::empty(torrent_dir) || std::empty(info_hash))
+    {
+        return {};
+    }
+
+    auto const path = task_id_path(torrent_dir, info_hash);
+    auto* const fp = std::fopen(path.c_str(), "re");
+    if (fp == nullptr)
+    {
+        return {};
+    }
+
+    auto buffer = std::array<char, 32>{};
+    auto const read = std::fgets(std::data(buffer), static_cast<int>(std::size(buffer)), fp) != nullptr;
+    std::fclose(fp);
+    if (!read)
+    {
+        return {};
+    }
+
+    auto const value = std::atoi(std::data(buffer));
+    return value > 0 ? static_cast<tr_torrent_id_t>(value) : tr_torrent_id_t{};
+}

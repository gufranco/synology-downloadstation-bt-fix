     return nullptr;
 }
 
+namespace
+{
+thread_local tr_torrent_id_t pending_torrent_id = {};
+}
+
+void tr_torrents_set_pending_id(tr_torrent_id_t id)
+{
+    pending_torrent_id = id;
+}
+
 tr_torrent_id_t tr_torrents::add(tr_torrent* tor)
 {
-    auto const id = static_cast<tr_torrent_id_t>(std::size(by_id_));
-    by_id_.push_back(tor);
+    auto const requested_id = pending_torrent_id;
+    pending_torrent_id = tr_torrent_id_t{};
+
+    auto id = tr_torrent_id_t{};
+
+    if (requested_id > tr_torrent_id_t{})
+    {
+        auto const uid = static_cast<size_t>(requested_id);
+
+        if (uid >= std::size(by_id_))
+        {
+            by_id_.resize(uid + 1U, nullptr);
+        }
+
+        if (by_id_[uid] == nullptr)
+        {
+            by_id_[uid] = tor;
+            id = requested_id;
+        }
+    }
+
+    if (id == tr_torrent_id_t{})
+    {
+        id = static_cast<tr_torrent_id_t>(std::size(by_id_));
+        by_id_.push_back(tor);
+    }
+
     by_hash_.insert(std::lower_bound(std::begin(by_hash_), std::end(by_hash_), tor, CompareTorrentByHash), tor);
     return id;
 }
